+@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
+
+body{
+font-family:'Poppins',sans-serif;
+background:#F4F7FB;
+margin:0;
+color:#1F2937;
+}
+
+.sidebar{
+width:250px;
+background:#0B3C5D;
+height:100vh;
+position:fixed;
+color:white;
+}
+
+.sidebar a{
+display:block;
+padding:15px 20px;
+color:white;
+text-decoration:none;
+}
+
+.sidebar a:hover{
+background:#1D9BF0;
+}
+
+.content{
+margin-left:250px;
+padding:30px;
+}
+
+.card-box{
+background:white;
+border-radius:10px;
+padding:25px;
+box-shadow:0 5px 15px rgba(0,0,0,0.08);
+margin-bottom:20px;
+}
+
+.btn-primary{
+background:#1D9BF0;
+border:none;
+}
+
+.btn-primary:hover{
+background:#0B3C5D;
+}
+
+table{
+background:white;
+border-radius:8px;
+}
+
+thead{
+background:#0B3C5D;
+color:white;
+}
+
+.question-box{
+background:white;
+padding:25px;
+border-radius:10px;
+box-shadow:0 5px 15px rgba(0,0,0,0.08);
+margin-bottom:20px;
+}
+
